# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# JWT signing key. Required. Any long random string.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres credentials. Required by docker compose.
# Read by the postgres image ONLY when it first initializes an empty data
# volume -- changing them later does not change an existing database.
# Use only letters, digits, - _ . in the password: it is embedded in a URL and
# passed through Compose interpolation, so @ : / ? # % $ will break it.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Database name. Optional; docker compose defaults to military_db.
# POSTGRES_DB=military_db

# Send the session cookie only over HTTPS. Optional; defaults to TRUE.
# docker compose already sets it false for the local http stack, so you do not
# need it here. Set it false only if you run the backend directly on the host
# over http -- with the default, the browser accepts the login response and
# then silently drops the cookie, which looks like "login does nothing".
# Never set this false anywhere reachable off your machine.
# COOKIE_SECURE=false

# Database connection string. Required -- backend/database.py raises at import
# if it is missing or empty (DATA-H11). There is no fallback: one used to
# default to a local SQLite file, so a deployment that forgot this variable
# came up looking healthy on an ephemeral database.
#
#  - Under docker compose it is supplied by docker-compose.yml, built from the
#    three variables above. You do not need it here for compose.
#  - Running the backend directly on the host -- uvicorn, python -m
#    backend.seed_data, python -m backend.bootstrap_admin, alembic -- fill it
#    in. For ordinary local work that is:  sqlite:///./sql_app.db
#
# Left EMPTY rather than pre-filled, like SECRET_KEY above and for the same
# reason: a template that ships a working SQLite URL would put the silent
# ephemeral database back, one copy of this file later, which is the whole of
# what DATA-H11 removed.
#
# Do NOT put the compose URL here: "db" resolves only inside Docker, and
# docker-compose.yml publishes no host port for Postgres, so the host cannot
# reach it either way.
#
# Filling this in is safe for compose: load_dotenv() does not override
# variables that are already set, so the URL compose injects into the container
# still wins over this file (which the container sees via the ./:/app bind
# mount).
DATABASE_URL=
