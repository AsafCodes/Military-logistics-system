# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# JWT signing key. Required. Any long random string.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres credentials. Required by docker compose.
# Read by the postgres image ONLY when it first initializes an empty data
# volume -- changing them later does not change an existing database.
# Use only letters, digits, - _ . in the password: it is embedded in a URL and
# passed through Compose interpolation, so @ : / ? # % $ will break it.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Database name. Optional; docker compose defaults to military_db.
# POSTGRES_DB=military_db

# DATABASE_URL is intentionally left unset here.
#  - Under docker compose it is supplied by docker-compose.yml, built from the
#    three variables above. Do not set it in .env.
#  - Running the backend directly on the host (uvicorn / seed_data), leaving it
#    unset makes backend/database.py fall back to sqlite:///./sql_app.db, which
#    is the intended local workflow. Setting the compose URL below would point
#    the host process at "db", a hostname that only resolves inside Docker.
# DATABASE_URL=postgresql://USER:PASSWORD@db:5432/military_db
